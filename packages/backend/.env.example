DATABASE_URL="postgresql://voyagin:voyagin@localhost:5432/voyagin"
PORT=3000
JWT_SECRET="change-me-in-production"
# Doit correspondre au KID configuré côté dashboard PowerSync Cloud (Client Auth).
POWERSYNC_JWT_KID="voyagin-backend"
# URL de l'instance PowerSync Cloud (Client Auth) — utilisée comme revendication "aud" du token
# PowerSync dédié émis par POST /api/auth/powersync-token. Obligatoire : sans elle, PowerSync Cloud
# rejette toujours le token avec PSYNC_S2105 ("JWT payload is missing a required claim aud"), donc pas
# de valeur par défaut générique pertinente ici. Le serveur refuse de démarrer si elle est absente.
POWERSYNC_INSTANCE_URL="https://6a90523c02481fb31b918cee.powersync.journeyapps.com"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
