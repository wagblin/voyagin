generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id           String        @id
  name         String
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  participants Participant[]
  photos       Photo[]

  @@map("trips")
}

model Participant {
  id     String @id @default(uuid())
  userId String
  name   String
  role   String
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@map("participants")
}

model User {
  id             String   @id
  email          String   @unique
  name           String
  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("users")
}

model Photo {
  id         String   @id
  tripId     String
  uploaderId String
  imageUrl   String
  latitude   Float?
  longitude  Float?
  takenAt    DateTime
  caption    String?
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("photos")
}
